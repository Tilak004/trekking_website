# Caddy: gets and renews the HTTPS certificate automatically, and passes visitors
# to the Go website, which listens only on this machine (127.0.0.1:8080).
# The admin console is served from its own address, admin.DOMAIN, protected by two
# separate passwords: the browser prompt below, then the admin login inside the app.
# (The console itself still only listens on this machine; Caddy is the only way in.)
#
# "DOMAIN" is replaced with your real domain by deploy/server-setup.sh.

www.DOMAIN {
	redir https://DOMAIN{uri} permanent
}

DOMAIN {
	encode zstd gzip

	# Built frontend files have a hash in their name, so they can be cached for a year.
	@assets path /static/app/assets/*
	header @assets Cache-Control "public, max-age=31536000, immutable"

	# Photos change rarely; let browsers keep them for a day.
	@photos path /photos/*
	header @photos Cache-Control "public, max-age=86400"

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		X-Frame-Options "SAMEORIGIN"
		-Server
	}

	# Booking and enquiry forms accept photos up to 5 MB; keep a sane overall limit.
	request_body {
		max_size 12MB
	}

	reverse_proxy 127.0.0.1:8080
}

# ---- Admin console: https://admin.DOMAIN ----
admin.DOMAIN {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "no-referrer"
		X-Frame-Options "DENY"
		X-Robots-Tag "noindex, nofollow"
		-Server
	}

	# First password. The browser asks for it before any page is shown, so strangers and
	# bots never even reach the admin login form. The username and password hash live in
	# /etc/caddy/admin-auth.caddy (created by server-setup.sh, kept out of git).
	import /etc/caddy/admin-auth.caddy

	request_body {
		max_size 12MB
	}

	reverse_proxy 127.0.0.1:8081
}
