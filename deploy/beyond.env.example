# Settings for both services. server-setup.sh creates /etc/beyond/beyond.env from this
# (with your domain filled in). Edit it there, then: sudo systemctl restart beyond-public beyond-admin

# Your public address. Used for WhatsApp/Instagram link previews and the admin console's links.
BASE_URL=https://DOMAIN
PUBLIC_URL=https://DOMAIN
# Where admins reach the console. Shown to signed-in admins as a link in the public site's account menu.
ADMIN_URL=https://admin.DOMAIN

# Nightly backup (public service, 02:00 server time). Copies go to /var/lib/beyond/backups,
# 30 kept. To also copy each backup off this machine (recommended), install rclone, add a
# Google Drive remote called "gdrive", and uncomment the next line:
#BACKUP_UPLOAD=rclone copy {file} gdrive:beyond-backups
BACKUP_DIR=/var/lib/beyond/backups
#BACKUP_AT=02:00
#BACKUP_KEEP=30

# Optional: email an alert to the team for every new enquiry (see enquiries.go).
# With a Gmail account, use an "App password" (Google Account > Security > 2-Step Verification).
# Without these settings, enquiries are still saved and shown in the admin console.
#SMTP_USER=youraddress@gmail.com
#SMTP_PASS=your-app-password
#SMTP_HOST=smtp.gmail.com
#SMTP_PORT=587
#ENQUIRY_EMAIL=where-alerts-should-go@example.com

# The very first start creates the admin account with a random password (see
# "journalctl -u beyond-public"). Do NOT put a password here. Set your own with:
#   sudo -u beyond env ADMIN_EMAIL=you@example.com ADMIN_PASSWORD='a-long-password' \
#     /opt/beyond/beyond -db /var/lib/beyond/beyond.db -reset-admin-password
